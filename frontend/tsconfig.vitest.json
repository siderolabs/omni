{
  "extends": "./tsconfig.app.json",
  "include": [
    "vitest.setup.*",
    "mocks/**/*",
    "src/**/*.spec.*",
    "src/types/**/*",
    "env.d.ts",
    "typed-router.d.ts"
  ],
  "exclude": ["src/**/*.mocks.*", "src/**/*.stories.*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

    "lib": ["ES2023"],
    "types": ["node", "jsdom", "@testing-library/jest-dom"],

    "paths": {
      "@/*": ["./src/*"],
      "@mocks/*": ["./mocks/*"]
    }
  }
}
